  "services": {
    "ap_area_report": {
      "name": "AP → Area report",
      "description": "Lists every access point with its HA Area and flags APs without an Area or with an Area that differs from the expected table.",
      "fields": {
        "config_entry_id": {
          "name": "Config entry",
          "description": "Only needed with several controllers."
        },
        "mapping": {
          "name": "Expected mapping",
          "description": "MAC → room, e.g. {\"AA-BB-CC-DD-EE-FF\": \"Room 01\"}."
        },
        "csv": {
          "name": "Expected CSV",
          "description": "CSV with columns mac and area (or room)."
        }
      }
    },
    "assign_ap_areas": {
      "name": "Assign AP Areas",
      "description": "Sets each access point's HA Area from a MAC → room table. APs are matched by MAC, not by name.",
      "fields": {
        "config_entry_id": {
          "name": "Config entry",
          "description": "Only needed with several controllers."
        },
        "mapping": {
          "name": "Mapping",
          "description": "MAC → room, e.g. {\"AA-BB-CC-DD-EE-FF\": \"Room 01\"}."
        },
        "csv": {
          "name": "CSV",
          "description": "CSV with columns mac and area (or room)."
        },
        "create_missing_areas": {
          "name": "Create missing Areas",
          "description": "Create an Area if no Area with that name exists."
        }
      }
    },
    "import_devices": {
      "name": "Import devices",
      "description": "Imports fixed/employee devices from CSV (mac, name, category, owner, note).",
      "fields": {
        "csv": {
          "name": "CSV",
          "description": "CSV text."
        },
        "replace": {
          "name": "Replace",
          "description": "Replace the whole list instead of merging."
